# ── Pairing layer ─────────────────────────────────────────────
# Telegram pairing bot (many users can pair their own numbers)
TELEGRAM_TOKEN=
OWNER_TELEGRAM_ID=

# Website pairing channel (Neon: varnox_pairing_requests)
NEON_DATABASE_URL=

# Health/landing server port (default 3000)
PORT=3000

# ── Varnox channel ────────────────────────────────────────────
# Lets the bot be talked to from inside Varnox. Pressing Start in the app opens a
# conversation and sends /start; every message after that is answered the same way.
#
# The bot polls outwards, so it needs no inbound port and no allocated port on the
# panel - which is what makes it work on Pterodactyl, behind NAT, anywhere.
#
# Get the token from Varnox: Bots -> create a bot -> the vx_... value, shown once.
# Revoking that token in Varnox stops this channel within one poll.
VARNOX_BOT_TOKEN=

# The Varnox deployment to talk to. Change this only if you are self-hosting Varnox.
VARNOX_URL=https://varnox-chat.vercel.app
